{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "allowImportingTsExtensions": true,
        "paths": {
            "@cognis/core": ["./src/core/index.ts"]
        },
        "allowJs": true,
        "checkJs": false,
        "target": "ES2024",
        "composite": false,
        "incremental": false,
        "jsx": "preserve"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.mts", "src/**/*.cts"],
    "exclude": ["**/dist/**", "**/node_modules/**"]
}
