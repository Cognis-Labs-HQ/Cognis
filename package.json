{
    "name": "cognis",
    "private": true,
    "version": "0.1.0",
    "description": "Cognis monorepo scaffold",
    "workspaces": [
        "src/api",
        "src/core",
        "src/adapters/*/*",
        "src/tooling/*",
        "src/gateways",
        "src/modules"
    ],
    "scripts": {
        "build": "npm run build:ui && npm run build:server",
        "build:ui": "node src/tooling/scripts/build-ui.mjs",
        "build:server": "node src/tooling/scripts/build-server.mjs",
        "check:ui-build": "node src/tooling/scripts/check-ui-build.mjs",
        "check:server-build": "node src/tooling/scripts/check-server-build.mjs",
        "typecheck": "node src/tooling/scripts/gen-tsconfig.mjs && tsc -p tsconfig.json --noEmit",
        "lint": "node ./src/tooling/scripts/lint-placeholder.mjs && node ./src/tooling/scripts/lint-readable.mjs",
        "test": "node --import tsx --test $(find . \\( -name \"*.test.ts\" -o -name \"*.test.js\" \\) -not -path \"*/node_modules/*\" -print)",
        "start": "node --import tsx src/api/main.ts",
        "start:production": "node dist/server/src/api/main.js",
        "ci:test": "npm run typecheck && npm test",
        "cli": "node --import tsx src/tooling/cli/index.ts"
    },
    "devDependencies": {
        "esbuild": "^0.25.0",
        "prettier": "^3.8.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
