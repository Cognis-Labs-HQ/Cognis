{
  "name": "cognis",
  "private": true,
  "version": "0.1.0",
  "description": "Cognis monorepo scaffold",
  "workspaces": [
    "src/api",
    "src/core",
    "src/adapters/*",
    "src/tooling/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ./src/tooling/scripts/lint-placeholder.mjs && node ./src/tooling/scripts/lint-readable.mjs",
    "test": "node --import tsx --test $(find . \\( -name \"*.test.ts\" -o -name \"*.test.js\" \\) -not -path \"*/node_modules/*\" -print)",
    "start": "node --import tsx src/api/main.ts",
    "ci:test": "npm run typecheck && npm test",
    "cli": "node --import tsx src/tooling/cli/index.ts"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
