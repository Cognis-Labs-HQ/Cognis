# Cognis environment variable reference.
# Copy this file to .env and fill in values before running docker compose.

# ── PostgreSQL (required when DB_TYPE=postgresql) ─────────────────────────────
# Database name, user, and password for the PostgreSQL container and the app.
POSTGRES_DB=cognis
POSTGRES_USER=cognis
POSTGRES_PASSWORD=change-me

# ── Application ───────────────────────────────────────────────────────────────
# TCP port exposed on the host.
PORT=3000

# Host the server binds to inside the container. Default: 0.0.0.0 (all interfaces).
# LISTEN_HOST=0.0.0.0

# DB_TYPE selects the database backend: sqlite | postgresql | mariadb
# Defaults to sqlite in the image; overridden to postgresql in docker-compose.yml.
# DB_TYPE=postgresql

# Full connection string when DB_TYPE is postgresql or mariadb.
# Constructed automatically from the POSTGRES_* vars in docker-compose.yml.
# DATABASE_URL=postgresql://cognis:change-me@db:5432/cognis

# Absolute path for the SQLite database file (only used when DB_TYPE=sqlite).
# SQLITE_PATH=/app/data/cognis.sqlite

# Log verbosity: debug | info | warn | error
# LOG_LEVEL=info

# Log file path inside the container.
# LOG_FILE=/app/logs/app.log

# Access token lifetime in seconds (default 12 hours).
# COGNIS_ACCESS_TOKEN_TTL_SECONDS=43200

# Path where the in-process access token store is written (non-Docker environments).
# COGNIS_ACCESS_TOKEN_STORE_PATH=/tmp/cognis-access-tokens.json

# Root directory where module subdirectories are discovered. Internal modules live directly
# under this path; external module archives are expected under $COGNIS_MODULES_ROOT/external.
# COGNIS_MODULES_ROOT=/app/src/modules

# Root directory where gateway subdirectories are discovered.
# COGNIS_GATEWAYS_ROOT=/app/src/gateways

# Root directory where adapter subdirectories are discovered.
# COGNIS_ADAPTERS_ROOT=/app/src/adapters

# Path at which the CLI bootstrap token is written inside the container.
# COGNIS_CLI_TOKEN_PATH=/app/config/cli-access.token

# Colon-separated list of additional paths scanned for module CLI subcommand index.js files.
# COGNIS_MODULE_CLI_PATHS=

# Base URL for CLI commands to reach the Cognis API (non-Docker environments).
# COGNIS_API_URL=http://localhost:3000

# Set to 1 to enable the UI demo mode (pre-populated example data).
# COGNIS_UI_DEMO_MODE=0

# Data encryption secret used by the app runtime. Docker images default to
# "not-secure-change-me", so set this to a strong random value for deployments.
# DATA_ENCRYPTION_KEY=replace-with-strong-random-key

# ── Networking ────────────────────────────────────────────────────────────────
# Internal service hostname (used for inter-service links, e.g. notification emails).
# HOST=cognis

# Publicly reachable URL of the Cognis instance (used in email links sent to users).
# Leave empty to fall back to http://$HOST.
# EXTERNAL_HOST=

# ── File / media ─────────────────────────────────────────────────────────────
# Directory where uploaded media files are stored.
# MEDIA_LOCATION=/app/media
