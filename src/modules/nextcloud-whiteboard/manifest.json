{
    "id": "nextcloud-whiteboard",
    "name": "Nextcloud Whiteboard",
    "version": "2.2.73",
    "class": "extension",
    "coreApiVersion": "v1",
    "capabilities": [
        "whiteboard:collaboration",
        "whiteboard:access-control",
        "whiteboard:getEmbedUrl",
        "whiteboard:fetchBoardData"
    ],
    "entrypoints": {
        "bootstrap": "./bootstrap.js",
        "api": "./api/index.js",
        "ui": "./ui/index.html",
        "cli": "./cli/index.js"
    },
    "publisher": "Cognis Labs HQ",
    "ui": {
        "componentConfig": {
            "scriptUrl": "/static/modules/nextcloud-whiteboard/admin-section.js"
        }
    },
    "requires": ["social:profile", "share"]
}
