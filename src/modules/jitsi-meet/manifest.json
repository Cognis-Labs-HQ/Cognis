{
    "id": "jitsi-meet",
    "name": "Jitsi Meet",
    "version": "1.0.0",
    "class": "extension",
    "coreApiVersion": "v1",
    "capabilities": ["video:meetings", "ui:page", "ui:navbar", "db:meetings"],
