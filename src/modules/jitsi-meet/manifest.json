{
    "id": "jitsi-meet",
    "name": "Jitsi Meet",
    "version": "1.2.6",
    "class": "extension",
    "coreApiVersion": "v1",
    "capabilities": ["meeting:video", "meeting:chat", "meeting:moderation"],
    "entrypoints": {
        "bootstrap": "./bootstrap.js",
        "api": "./api/index.js",
        "ui": "./ui/index.html"
    },
    "publisher": "Cognis Labs HQ",
    "ui": {
        "componentConfig": {
            "scriptUrl": "/static/modules/jitsi-meet/admin-config-popup.js"
        }
    },
    "share": {
        "shareable": true,
        "mountScriptUrl": "/static/modules/jitsi-meet/share-mount.js",
        "stringsBaseUrl": "/static/modules/jitsi-meet/languages",
        "guestApiScopes": [
            "meeting:join",
            "participants:read",
            "chat:read",
            "chat:write"
        ]
    },
    "requires": ["social"]
}
