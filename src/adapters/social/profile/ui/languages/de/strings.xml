  <string name="module.social.profile.tutorial.profile.title">Profile und Beiträge</string>
  <string name="module.social.profile.tutorial.profile.profile.identity.title">Profilidentität</string>
  <string name="module.social.profile.tutorial.profile.profile.identity.body">Prüfen Sie Identität und Verfügbarkeit; Ihr eigenes Profil bietet Bearbeitungsfunktionen. Bewegen Sie den Zeiger über einen Profillink, um eine Vorschau zu sehen, und wählen Sie ihn aus, um das Profil zu öffnen.</string>
  <string name="module.social.profile.tutorial.profile.posts.title">Beiträge</string>
  <string name="module.social.profile.tutorial.profile.posts.body">Lesen Sie sichtbare Beiträge und nutzen Sie die für Ihr Konto erlaubten Aktionen.</string>
  <string name="module.social.profile.tutorial.profile.social.actions.title">Soziale Aktionen</string>
  <string name="module.social.profile.tutorial.profile.social.actions.body">Folgen, Nachrichten und Beziehungen steuern Sie am Profil; prüfen Sie zuvor die ausgewählte Person. Im eigenen Profil öffnet Profil bearbeiten Ihre Angaben. Bei einem Speicherfehler bleiben Ihre Änderungen zum Korrigieren und erneuten Versuchen erhalten.</string>
  <string name="module.social.profile.tutorial.profile.preview.post.title">Beitrag prüfen</string>
  <string name="module.social.profile.tutorial.profile.preview.post.body">Verfassen Sie einen Beitrag und prüfen Sie Formatierung und Anhänge in der Vorschau. Kontrollieren Sie vor dem Veröffentlichen die Zielgruppe.</string>
  <string name="ui.app.profile.save_pending_closed">Das Schließen macht einen gesendeten Speichervorgang nicht rückgängig. Laden Sie die Profilseite neu, um das Ergebnis zu prüfen.</string>
