  <string name="adapter.study.flashcards.tutorial.manage.deck.share.deck.title">Bagikan Kepada Pelajar</string>
  <string name="adapter.study.flashcards.tutorial.manage.deck.share.deck.body">Gunakan kontrol berbagi untuk memilih penerima dan akses. Tinjau dialog sebelum mengonfirmasi siapa yang boleh memakai dek.</string>
